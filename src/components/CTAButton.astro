---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;
const classes = ['cta-btn', variant === 'secondary' ? 'secondary' : '', className]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes}><slot /></a>
